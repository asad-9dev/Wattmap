{
  "name": "wattmap",
  "version": "0.1.0",
  "private": true,
  "description": "Ontario school energy analytics platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "data:fetch": "python scripts/ingest/fetch_sources.py",
    "data:ingest": "python scripts/ingest/run.py",
    "analytics:rebuild": "tsx scripts/analytics/rebuild.ts",
    "db:seed-local": "tsx scripts/dev/seed-local.ts",
    "test:ingest": "python -m unittest discover -s tests/ingest",
    "admin:unresolved": "python scripts/admin/list_unresolved.py",
    "admin:approve": "python scripts/admin/approve_match.py",
    "admin:validate": "tsx scripts/admin/validate-db.ts",
    "admin:stats": "tsx scripts/admin/export-stats.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.9.1",
    "next": "14.2.35",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
