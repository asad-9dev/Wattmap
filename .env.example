# Copy to .env.local and fill in. Never commit real values.
# Both Next.js and the Python ingestion pipeline read .env.local first, then .env.

# Postgres connection string — Supabase dashboard → Connect → "Transaction pooler" (port 6543).
# Used by Drizzle migrations and the Next.js server. Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project URL. Not secret; the ingestion pipeline also uses it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase service-role key. Bypasses Row Level Security — ingestion/server only, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
